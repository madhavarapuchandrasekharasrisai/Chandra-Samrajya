# ─── Supabase (Auth) ─────────────────────────────────────────────────────────
# Project URL from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Recommended: new publishable key (sb_publishable_…)
# Dashboard → Settings → API → Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Legacy fallback (anon JWT) — remove after migrating to publishable key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ─── Database (Drizzle / Postgres) ───────────────────────────────────────────
# Supabase → Settings → Database → Connection string (Transaction pooler for serverless)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Direct connection (migrations / drizzle-kit push only — not for Vercel runtime)
DIRECT_URL=postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres

# ─── AI (server-only — never prefix with NEXT_PUBLIC_) ─────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
